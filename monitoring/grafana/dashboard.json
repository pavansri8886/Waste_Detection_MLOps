{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "rate(ml_predictions_total[1m]) * 60",
          "legendFormat": "predictions/minute",
          "refId": "A"
        }
      ],
      "title": "Requests Per Minute",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ml_inference_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "title": "Inference Latency P95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "ml_predictions_by_model_total",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Detections Per Model",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "rate(ml_validation_errors_total[5m]) / clamp_min(rate(ml_predictions_total[5m]) + rate(ml_validation_errors_total[5m]), 1)",
          "legendFormat": "validation error rate",
          "refId": "A"
        }
      ],
      "title": "Validation Error Rate",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "tags": [
    "mlops",
    "waste-detection"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Waste Detection Dashboard",
  "uid": "waste-detection",
  "version": 2
}
